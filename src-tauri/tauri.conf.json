{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cursor-manager",
  "version": "1.9.1",
  "identifier": "com.cursor.manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
"beforeDevCommand": "npx vite",
"beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Cursor续杯",
        "width": 1100,
        "height": 850,
        "minWidth": 860,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}